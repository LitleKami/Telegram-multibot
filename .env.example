# Copy this file to .env and fill in real tokens.
# Each bot file declares its own env var name via BotPlugin(token_env=...).
# A bot whose var is missing/empty is skipped at startup (logged, not fatal).

ECHO_BOT_TOKEN=
STATEFUL_EXAMPLE_BOT_TOKEN=

# Your existing bots — add one line per bot file, matching whatever
# token_env name you give it in bots/<name>.py:
# PHOTO_STUDIO_BOT_TOKEN=
# JP_TRANSLATOR_BOT_TOKEN=
# HUMANIZER_BOT_TOKEN=
# VIDBOT_TOKEN=
